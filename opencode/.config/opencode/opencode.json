{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cat *>>*": "deny",
      "cat *>*": "deny"
    },
    "webfetch": "allow"
  },

  "default_agent": "build"
}
